# Copy to .env and adjust. Every variable is validated at start-up by src/config/env.config.ts.

# Cypress Real World App front-end (React) and back-end (Express) origins.
# RWA's front-end hard-codes http://localhost:<VITE_BACKEND_PORT>, so keep both on localhost.
BASE_URL=http://localhost:3000
API_URL=http://localhost:3001

# Re-seed the RWA database (POST /testData/seed) once before the run for a deterministic baseline.
RESET_DB_ON_START=true

# Password applied to every user the factories create.
TEST_USER_PASSWORD=Pl@ywright-E2E-2026

# trace | debug | info | warn | error | silent
LOG_LEVEL=info

# Comma-separated engines to run e2e specs on: chromium,firefox,webkit
BROWSERS=chromium
